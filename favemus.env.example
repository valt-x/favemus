# Favemus - Environment Configuration
# Copy this file to favemus.env and fill in your values
# chmod 600 favemus.env

# --- Harness Admin (Super Admin) ---
# Used for tenant management (create/suspend tenants, webhooks)
HARNESS_ADMIN_TOKEN=your-super-admin-token-here

# --- Telegram Bot (Temp Test) ---
# Get from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here

# --- WhatsApp (Meta Cloud API) ---
# Set up at https://developers.facebook.com/
WHATSAPP_VERIFY_TOKEN=your-verify-token-here
WHATSAPP_ACCESS_TOKEN=your-permanent-system-user-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_APP_SECRET=your-app-secret-here
WHATSAPP_API_VERSION=v21.0

# --- Harness Configuration ---
FAVEMUS_DB=/home/baymax/favemus/favemus.db
FAVEMUS_CONFIDENCE_FLOOR=0.35
FAVEMUS_PLATFORM=manual
FAVEMUS_ALLOW_REGISTRATION=false
LAYA_DEVICE=cpu
HF_HOME=/home/baymax/.cache/huggingface
OMP_NUM_THREADS=2
MKL_NUM_THREADS=2

# --- Systemd Service ---
# Copy favemus.service to /etc/systemd/system/
# Then: sudo systemctl daemon-reload && sudo systemctl enable --now favemus

# --- Stripe Billing (optional) ---
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_STARTER=price_...
# STRIPE_PRICE_PRO=price_...
# STRIPE_PRICE_ENTERPRISE=price_...
