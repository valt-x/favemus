<div
  id="favemus-chat"
  class="favemus-chat-root"
  data-proxy-root="/apps/favemus"
  data-title="{{ block.settings.title | escape }}"
  data-greeting="{{ block.settings.greeting | escape }}"
  data-color="{{ block.settings.color }}"
></div>

{% schema %}
{
  "name": "Favemus chat",
  "target": "body",
  "stylesheet": "chat.css",
  "javascript": "chat.js",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Chat title",
      "default": "Chat with us"
    },
    {
      "type": "text",
      "id": "greeting",
      "label": "Greeting message",
      "default": "Hi! How can we help you today?"
    },
    {
      "type": "color",
      "id": "color",
      "label": "Bubble colour",
      "default": "#111111"
    }
  ]
}
{% endschema %}
